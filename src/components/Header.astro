---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<!-- 1. IZQUIERDA: Marca y Tu Logo -->
		<div class="brand-section">
			<h2><a href="/">GASTRO<br />VALENCIA</a></h2>
			<div class="my-logo">Tu Logo</div>
		</div>

		<!-- 2. CENTRO: Navegación -->
		<div class="nav-links">
			<HeaderLink href="/">INTRO</HeaderLink>
			<HeaderLink href="/mapa">MAPA GASTRONÓMICO</HeaderLink>
			<HeaderLink href="/blog">BLOG</HeaderLink>
			<HeaderLink href="/about">NOSOTROS</HeaderLink>
		</div>

		<!-- 3. DERECHA: Patrocinador -->
		<div class="sponsor-section">
			<span class="sponsor-label">SPONSOR</span>
			<div class="sponsor-logo">HUECO MARCA</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		border-bottom: 1px solid #eaeaea;
		position: sticky;
		top: 0;
		z-index: 1000;
		display: block;
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0.8em 0;
		gap: 1em;
	}
	
	.brand-section {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	
	h2 {
		margin: 0;
		font-size: 1.15em;
		letter-spacing: -0.5px;
	}
	
	h2 a {
		text-decoration: none;
		color: #111;
		font-weight: 900;
		font-family: "Georgia", serif; 
		display: inline-block;
		line-height: 0.9;
		text-transform: uppercase;
	}
	
	.my-logo {
		font-size: 0.7rem;
		font-weight: 800;
		color: #fff;
		background: #111;
		padding: 0.35em 0.7em;
		border-radius: 4px;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.nav-links {
		display: flex;
		gap: 1.8em;
	}
	
	.nav-links a {
		color: #555;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 1px;
		padding: 0.4em 0;
		border-bottom: 3px solid transparent;
		transition: all 0.2s ease;
	}
	
	.nav-links a:hover, .nav-links a.active {
		color: #d9381e;
		border-bottom-color: #d9381e;
	}

	.sponsor-section {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	
	.sponsor-label {
		font-size: 0.6rem;
		color: #999;
		text-transform: uppercase;
		font-weight: 800;
		letter-spacing: 0.5px;
	}
	
	.sponsor-logo {
		font-size: 0.7rem;
		font-weight: 700;
		color: #d9381e;
		background: #fdf5f3;
		padding: 0.3em 0.7em;
		border-radius: 4px;
		border: 1px dashed #fbe5e1;
		text-transform: uppercase;
	}

	@media (max-width: 900px) {
		nav {
			flex-wrap: wrap;
		}
		.nav-links {
			order: 3;
			width: 100%;
			justify-content: center;
			gap: 1.2em;
			margin-top: 0.5rem;
		}
	}
</style>